{
  "name": "exclusive",
  "version": "1.0.0",
  "description": "Backend API for Exclusive - Premium Clothing Brand",
  "main": "app.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon server.js",
    "build": "npm run clean && npm run build:server && npm run copy:email-templates",
    "build:server": "esbuild server.js --bundle --platform=node --outdir=dist --minify --sourcemap",
    "clean": "rimraf dist",
    "copy:email-templates": "copyfiles -u 1 \"views/email/**/*\" dist/views/email",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docker:prod": "cross-env NODE_ENV=production TARGET=prod docker-compose up --build -d"
  },
  "author": "Eloquence98",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cron": "^4.1.0",
    "nodemailer": "^6.10.0",
    "pug": "^3.0.3",
    "sanitize-html": "^2.14.0",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "validator": "^13.12.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "axios": "^1.18.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=14"
  }
}