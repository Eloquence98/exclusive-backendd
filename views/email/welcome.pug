extends baseEmail

block content
  p Hi #{firstName},
  p Welcome to Exclusive! We're thrilled to have you join our premium fashion community 🎉
  
  div.welcome-message(style='background-color: #f7f7f7; padding: 2rem; border-radius: 5px; margin: 2rem 0;')
    p.heading-secondary(style='margin-bottom: 1rem; color: #DB4444;') Welcome Gift Inside!
    p Get ready to explore our exclusive collection of premium clothing and accessories. As a welcome gift, you'll receive:
    ul(style='list-style: none; padding-left: 0;')
      li(style='margin: 0.5rem 0;') ✨ Special offers on your first purchase
      li(style='margin: 0.5rem 0;') 🎁 Early access to upcoming sales
      li(style='margin: 0.5rem 0;') 💫 VIP member benefits
  
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank', style='background-color: #DB4444; border-color: #DB4444;') Complete Your Profile
  
  p Start exploring our latest collections and discover the perfect style that defines you. If you need any assistance with your shopping experience, our customer service team is here to help!
  p - Team Exclusive