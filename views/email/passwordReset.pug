extends baseEmail

block content
  p Hi #{firstName},
  p We received a request to reset your password for your Exclusive account. Don't worry, we're here to help!
  
  div.reset-details(style='background-color: #f7f7f7; padding: 2rem; border-radius: 5px; margin: 2rem 0;')
    p.heading-secondary(style='margin-bottom: 1rem;') Reset Your Password
    p Your password reset link is valid for 10 minutes. Please click the button below to create a new password.
    
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Reset Password
                  
  p If you didn't request a password reset, please ignore this email or contact our support team if you have concerns about your account security.
  
  p.footer-note(style='margin-top: 2rem; font-size: 0.9em; color: #7D8184;') For security reasons, this link will expire in 10 minutes.
  p - Team Exclusive
